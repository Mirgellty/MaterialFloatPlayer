{
  "manifest_version": 1,
  "name": "MaterialFloatPlayer",
  "slug": "MaterialFloatPlayer",
  "author": "Codex",
  "author_links": [],
  "description": "Material 风格悬浮播放器：圆角方形专辑封面、播放/上一首/下一首/播放模式按钮、滚动歌词，背景色可跟随专辑主要颜色或自定义",
  "preview": "preview.png",
  "version": "1.0.6",
  "type": "extension",
  "betterncm_version": ">=1.0.0",
  "injects": {
    "Main": [
      {
        "file": "main.js"
      }
    ]
  },
  "hijacks": {
    ">= 2.10.0 < 3.0.0": {
      "orpheus://orpheus/pub/module/main/music/list/index.html": {
        "type": "append",
        "code": "{{WINDOW_CODE}}"
      }
    }
  }
}
